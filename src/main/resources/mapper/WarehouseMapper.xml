<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spring_boot.dao.WarehouseMapper">

    <!-- 仓库结果映射 -->
    <resultMap id="WarehouseResultMap" type="com.example.spring_boot.entity.Warehouse">
        <id property="warehouse_id" column="warehouse_id"/>
        <result property="name" column="name"/>
        <result property="address" column="address"/>
        <result property="manager" column="manager"/>
        <result property="phone" column="phone"/>
    </resultMap>

    <!-- 新增仓库 -->
    <insert id="insertWarehouse" parameterType="com.example.spring_boot.entity.Warehouse">
        INSERT INTO warehouse (
            warehouse_id,
            name,
            address,
            manager,
            phone
        ) VALUES (
            #{warehouse_id},
            #{name},
            #{address},
            #{manager},
            #{phone}
        )
    </insert>

    <!-- 修改仓库信息 -->
    <update id="updateWarehouse" parameterType="com.example.spring_boot.entity.Warehouse">
        UPDATE warehouse
        SET
            name = #{name},
            address = #{address},
            manager = #{manager},
            phone = #{phone}
        WHERE warehouse_id = #{warehouse_id}
    </update>

    <!-- 删除仓库 -->
    <delete id="deleteWarehouse">
        DELETE FROM warehouse
        WHERE warehouse_id = #{warehouse_id}
    </delete>

    <!-- 根据ID查询仓库 -->
    <select id="selectWarehouseById" resultMap="WarehouseResultMap">
        select * from warehouse
        where warehouse_id = #{warehouse_id}
    </select>

    <!-- 查询所有仓库 -->
    <select id="selectAllWarehouses" resultMap="WarehouseResultMap">
        select * from warehouse
        order by warehouse_id
    </select>

</mapper>