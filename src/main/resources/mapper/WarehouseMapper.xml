<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spring_boot.mapper.WarehouseMapper">

    <!-- 仓库结果映射 -->
    <resultMap id="WarehouseResultMap" type="com.example.spring_boot.pojo.Warehouse">
        <id property="warehouse_id" column="warehouse_id"/>
        <result property="name" column="name"/>
        <result property="location" column="location"/>
        <result property="manager" column="manager"/>
        <result property="manager_phone" column="manager_phone"/>
    </resultMap>

    <!-- 新增仓库 -->
    <insert id="insertWarehouse" parameterType="com.example.spring_boot.pojo.Warehouse">
        INSERT INTO warehouse (
            warehouse_id,
            name,
            location,
            manager,
            manager_phone
        ) VALUES (
            #{warehouse_id},
            #{name},
            #{location},
            #{manager},
            #{manager_phone}
        )
    </insert>

    <!-- 修改仓库信息 -->
    <update id="updateWarehouse" parameterType="com.example.spring_boot.pojo.Warehouse">
        UPDATE warehouse
        SET
            name = #{name},
            location = #{location},
            manager = #{manager},
            manager_phone = #{manager_phone}
        WHERE warehouse_id = #{warehouse_id}
    </update>

    <!-- 删除仓库 -->
    <delete id="deleteWarehouse">
        DELETE FROM warehouse
        WHERE warehouse_id = #{warehouse_id}
    </delete>

    <!-- 根据ID查询仓库 -->
    <select id="selectWarehouseById" resultMap="WarehouseResultMap">
        select * from warehouse
        where warehouse_id = #{warehouse_id}
    </select>

    <!-- 查询所有仓库 -->
    <select id="selectAllWarehouses" resultMap="WarehouseResultMap">
        select * from warehouse
        order by warehouse_id
    </select>

    <!-- 根据名称查询仓库 -->
    <select id="selectWarehousesByName" resultMap="WarehouseResultMap">
        select * from warehouse
        where name like CONCAT('%', #{name}, '%')
        order by warehouse_id
    </select>

    <!-- 根据位置查询仓库 -->
    <select id="selectWarehousesByLocation" resultMap="WarehouseResultMap">
        select * from warehouse
        where location like CONCAT('%', #{location}, '%')
        order by warehouse_id
    </select>

    <!-- 根据管理员查询仓库 -->
    <select id="selectWarehousesByManager" resultMap="WarehouseResultMap">
        select * from warehouse
        where manager like CONCAT('%', #{manager}, '%')
        order by warehouse_id
    </select>

</mapper>