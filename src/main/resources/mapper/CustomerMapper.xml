<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spring_boot.dao.CustomerMapper">

    <!-- 客户结果映射 -->
    <resultMap id="CustomerResultMap" type="com.example.spring_boot.entity.Customer">
        <id property="customer_id" column="customer_id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="contact_phone" column="contact_phone"/>
    </resultMap>

    <!-- 新增客户 -->
    <insert id="insertCustomer" parameterType="com.example.spring_boot.entity.Customer">
        INSERT INTO customer (
            customer_id,
            name,
            type,
            contact_phone
        ) VALUES (
            #{customer_id},
            #{name},
            #{type},
            #{contact_phone}
        )
    </insert>

    <!-- 修改客户信息 -->
    <update id="updateCustomer" parameterType="com.example.spring_boot.entity.Customer">
        UPDATE customer
        SET
            name = #{name},
            type = #{type},
            contact_phone = #{contact_phone}
        WHERE customer_id = #{customer_id}
    </update>

    <!-- 删除客户 -->
    <delete id="deleteCustomer" parameterType="string">
        DELETE FROM customer
        WHERE customer_id = #{customer_id}
    </delete>

    <!-- 根据ID查询客户 -->
    <select id="selectCustomerById" parameterType="string" resultMap="CustomerResultMap">
        SELECT * FROM customer
        WHERE customer_id = #{customer_id}
    </select>

    <!-- 查询所有客户 -->
    <select id="selectAllCustomers" resultMap="CustomerResultMap">
        SELECT * FROM customer
        ORDER BY customer_id
    </select>

    <!-- 根据姓名查询客户 -->
    <select id="selectCustomersByName" parameterType="string" resultMap="CustomerResultMap">
        SELECT * FROM customer
        WHERE name LIKE CONCAT('%', #{name}, '%')
        ORDER BY customer_id
    </select>

    <!-- 根据联系电话查询客户 -->
    <select id="selectCustomerByPhone" parameterType="string" resultMap="CustomerResultMap">
        SELECT * FROM customer
        WHERE contact_phone = #{phone}
    </select>

    <!-- 根据客户类型查询客户 -->
    <select id="selectCustomersByType" parameterType="string" resultMap="CustomerResultMap">
        SELECT * FROM customer
        WHERE type = #{type}
        ORDER BY customer_id
    </select>

    <!-- 根据联系电话查询客户（精确匹配） -->
    <select id="selectCustomersByContactPhone" parameterType="string" resultMap="CustomerResultMap">
        SELECT * FROM customer
        WHERE contact_phone = #{contact_phone}
    </select>

</mapper>