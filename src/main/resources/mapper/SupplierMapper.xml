<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spring_boot.dao.SupplierMapper">

    <!-- 供应商结果映射 -->
    <resultMap id="SupplierResultMap" type="com.example.spring_boot.entity.Supplier">
        <id property="supplier_id" column="supplier_id"/>
        <result property="name" column="name"/>
        <result property="contact_phone" column="contact_phone"/>
        <result property="status" column="status"/>
    </resultMap>

    <!-- 新增供应商 -->
    <insert id="insertSupplier" parameterType="com.example.spring_boot.entity.Supplier">
        INSERT INTO supplier (
            supplier_id,
            name,
            contact_phone,
            status
        ) VALUES (
            #{supplier_id},
            #{name},
            #{contact_phone},
            #{status}
        )
    </insert>

    <!-- 修改供应商信息 -->
    <update id="updateSupplier" parameterType="com.example.spring_boot.entity.Supplier">
        UPDATE supplier
        SET
            name = #{name},
            contact_phone = #{contact_phone},
            status = #{status}
        WHERE supplier_id = #{supplier_id}
    </update>

    <!-- 删除供应商 -->
    <delete id="deleteSupplier">
        DELETE FROM supplier
        WHERE supplier_id = #{supplier_id}
    </delete>

    <!-- 根据ID查询供应商 -->
    <select id="selectSupplierById" resultMap="SupplierResultMap">
        SELECT * FROM supplier WHERE supplier_id = #{supplier_id}
    </select>

    <!-- 查询所有供应商 -->
    <select id="selectAllSuppliers" resultMap="SupplierResultMap">
        SELECT * FROM supplier ORDER BY supplier_id
    </select>

    <!-- 根据名称查询供应商 -->
    <select id="selectSuppliersByName" resultMap="SupplierResultMap">
        SELECT * FROM supplier WHERE name LIKE CONCAT('%', #{name}, '%')
    </select>

</mapper>