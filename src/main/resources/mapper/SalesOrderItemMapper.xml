<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spring_boot.dao.SalesOrderItemMapper">

    <!-- 销售订单明细结果映射 -->
    <resultMap id="SalesOrderItemResultMap" type="com.example.spring_boot.entity.SalesOrderItem">
        <id property="soi_id" column="soi_id"/>
        <result property="so_id" column="so_id"/>
        <result property="drug_id" column="drug_id"/>
        <result property="quantity" column="quantity"/>
        <result property="price" column="price"/>
        <result property="batch_no" column="batch_no"/>
    </resultMap>

    <!-- 新增销售订单明细 -->
    <insert id="insertSalesOrderItem" parameterType="com.example.spring_boot.entity.SalesOrderItem">
        INSERT INTO salesorderitem (
            soi_id,
            so_id,
            drug_id,
            quantity,
            price,
            batch_no
        ) VALUES (
            #{soi_id},
            #{so_id},
            #{drug_id},
            #{quantity},
            #{price},
            #{batch_no}
        )
    </insert>

    <!-- 修改销售订单明细 -->
    <update id="updateSalesOrderItem" parameterType="com.example.spring_boot.entity.SalesOrderItem">
        UPDATE salesorderitem
        SET
            so_id = #{so_id},
            drug_id = #{drug_id},
            quantity = #{quantity},
            price = #{price},
            batch_no = #{batch_no}
        WHERE soi_id = #{soi_id}
    </update>

    <!-- 删除销售订单明细 -->
    <delete id="deleteSalesOrderItem">
        DELETE FROM salesorderitem
        WHERE soi_id = #{soi_id}
    </delete>

    <!-- 根据ID查询销售订单明细 -->
    <select id="selectSalesOrderItemById" resultMap="SalesOrderItemResultMap">
        select * from salesorderitem
        where soi_id = #{soi_id}
    </select>

    <!-- 查询所有销售订单明细 -->
    <select id="selectAllSalesOrderItems" resultMap="SalesOrderItemResultMap">
        select * from salesorderitem
        order by soi_id
    </select>

    <!-- 根据销售订单ID查询明细 -->
    <select id="selectSalesOrderItemsBySoId" resultMap="SalesOrderItemResultMap">
        select * from salesorderitem
        where so_id = #{so_id}
    </select>

    <!-- 根据药品ID查询销售明细 -->
    <select id="selectSalesOrderItemsByDrugId" resultMap="SalesOrderItemResultMap">
        select * from salesorderitem
        where drug_id = #{drug_id}
    </select>

</mapper>