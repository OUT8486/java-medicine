<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spring_boot.dao.SalesOrderItemMapper">

    <!-- 销售订单明细结果映射 -->
    <resultMap id="SalesOrderItemResultMap" type="com.example.spring_boot.entity.SalesOrderItem">
        <id property="item_id" column="item_id"/>
        <result property="order_id" column="order_id"/>
        <result property="drug_id" column="drug_id"/>
        <result property="quantity" column="quantity"/>
        <result property="unit_price" column="unit_price"/>
        <result property="total_price" column="total_price"/>
    </resultMap>

    <!-- 新增销售订单明细 -->
    <insert id="insertSalesOrderItem" parameterType="com.example.spring_boot.entity.SalesOrderItem">
        INSERT INTO sales_order_item (
            item_id,
            order_id,
            drug_id,
            quantity,
            unit_price,
            total_price
        ) VALUES (
            #{item_id},
            #{order_id},
            #{drug_id},
            #{quantity},
            #{unit_price},
            #{total_price}
        )
    </insert>

    <!-- 修改销售订单明细 -->
    <update id="updateSalesOrderItem" parameterType="com.example.spring_boot.entity.SalesOrderItem">
        UPDATE sales_order_item
        SET
            order_id = #{order_id},
            drug_id = #{drug_id},
            quantity = #{quantity},
            unit_price = #{unit_price},
            total_price = #{total_price}
        WHERE item_id = #{item_id}
    </update>

    <!-- 删除销售订单明细 -->
    <delete id="deleteSalesOrderItem">
        DELETE FROM sales_order_item
        WHERE item_id = #{item_id}
    </delete>

    <!-- 根据ID查询销售订单明细 -->
    <select id="selectSalesOrderItemById" resultMap="SalesOrderItemResultMap">
        select * from sales_order_item
        where item_id = #{item_id}
    </select>

    <!-- 根据订单ID查询所有明细 -->
    <select id="selectSalesOrderItemsByOrderId" resultMap="SalesOrderItemResultMap">
        select * from sales_order_item
        where order_id = #{order_id}
        order by item_id
    </select>

</mapper>