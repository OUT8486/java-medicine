<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spring_boot.dao.UserMapper">

    <!-- 用户结果映射 -->
    <resultMap id="UserResultMap" type="com.example.spring_boot.entity.Users">
        <id property="user_id" column="user_id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="role" column="role"/>
    </resultMap>

    <!-- 根据用户名查询用户 -->
    <select id="findByUsername" parameterType="string" resultMap="UserResultMap">
        SELECT * FROM users WHERE username = #{username}
    </select>

    <!-- 插入新用户 -->
    <insert id="insertUser" parameterType="com.example.spring_boot.entity.Users">
        INSERT INTO users (user_id, username, password, role)
        VALUES (#{user_id}, #{username}, #{password}, #{role})
    </insert>

</mapper>