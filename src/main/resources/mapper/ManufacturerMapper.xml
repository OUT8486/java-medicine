<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spring_boot.mapper.ManufacturerMapper">

    <!-- 生产厂家结果映射（与数据库字段 manufacturer_id,name,credit_code 匹配） -->
    <resultMap id="ManufacturerResultMap" type="com.example.spring_boot.pojo.Manufacturer">
        <id property="manufacturer_id" column="manufacturer_id"/>
        <result property="name" column="name"/>
        <result property="credit_code" column="credit_code"/>
    </resultMap>

    <!-- 新增生产厂家 -->
    <insert id="insertManufacturer" parameterType="com.example.spring_boot.pojo.Manufacturer">
        INSERT INTO manufacturer (
            manufacturer_id,
            name,
            credit_code
        ) VALUES (
            #{manufacturer_id},
            #{name},
            #{credit_code}
        )
    </insert>

    <!-- 修改生产厂家信息 -->
    <update id="updateManufacturer" parameterType="com.example.spring_boot.pojo.Manufacturer">
        UPDATE manufacturer
        SET
            name = #{name},
            credit_code = #{credit_code}
        WHERE manufacturer_id = #{manufacturer_id}
    </update>

    <!-- 删除生产厂家 -->
    <delete id="deleteManufacturer">
        DELETE FROM manufacturer
        WHERE manufacturer_id = #{manufacturer_id}
    </delete>

    <!-- 根据ID查询生产厂家 -->
    <select id="selectManufacturerById" resultMap="ManufacturerResultMap">
        select * from manufacturer
        where manufacturer_id = #{manufacturer_id}
    </select>

    <!-- 查询所有生产厂家 -->
    <select id="selectAllManufacturers" resultMap="ManufacturerResultMap">
        select * from manufacturer
        order by manufacturer_id
    </select>

    <!-- 根据名称查询生产厂家 -->
    <select id="selectManufacturersByName" resultMap="ManufacturerResultMap">
        select * from manufacturer
        where name like CONCAT('%', #{name}, '%')
        order by manufacturer_id
    </select>

    <!-- （删除按联系人查询，数据库不含该列） -->

</mapper>