<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spring_boot.dao.ManufacturerMapper">

    <!-- 生产厂家结果映射 -->
    <resultMap id="ManufacturerResultMap" type="com.example.spring_boot.entity.Manufacturer">
        <id property="manufacturer_id" column="manufacturer_id"/>
        <result property="name" column="name"/>
        <result property="address" column="address"/>
        <result property="phone" column="phone"/>
        <result property="contact_person" column="contact_person"/>
    </resultMap>

    <!-- 新增生产厂家 -->
    <insert id="insertManufacturer" parameterType="com.example.spring_boot.entity.Manufacturer">
        INSERT INTO manufacturer (
            manufacturer_id,
            name,
            address,
            phone,
            contact_person
        ) VALUES (
            #{manufacturer_id},
            #{name},
            #{address},
            #{phone},
            #{contact_person}
        )
    </insert>

    <!-- 修改生产厂家信息 -->
    <update id="updateManufacturer" parameterType="com.example.spring_boot.entity.Manufacturer">
        UPDATE manufacturer
        SET
            name = #{name},
            address = #{address},
            phone = #{phone},
            contact_person = #{contact_person}
        WHERE manufacturer_id = #{manufacturer_id}
    </update>

    <!-- 删除生产厂家 -->
    <delete id="deleteManufacturer">
        DELETE FROM manufacturer
        WHERE manufacturer_id = #{manufacturer_id}
    </delete>

    <!-- 根据ID查询生产厂家 -->
    <select id="selectManufacturerById" resultMap="ManufacturerResultMap">
        select * from manufacturer
        where manufacturer_id = #{manufacturer_id}
    </select>

    <!-- 查询所有生产厂家 -->
    <select id="selectAllManufacturers" resultMap="ManufacturerResultMap">
        select * from manufacturer
        order by manufacturer_id
    </select>

</mapper>