<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spring_boot.dao.InventoryMapper">

    <!-- 库存结果映射 -->
    <resultMap id="InventoryResultMap" type="com.example.spring_boot.entity.Inventory">
        <id property="inventory_id" column="inventory_id"/>
        <result property="drug_id" column="drug_id"/>
        <result property="warehouse_id" column="warehouse_id"/>
        <result property="batch_no" column="batch_no"/>
        <result property="quantity" column="quantity"/>
        <result property="validity_date" column="validity_date"/>
    </resultMap>

    <!-- 新增库存记录 -->
    <insert id="insertInventory" parameterType="com.example.spring_boot.entity.Inventory">
        INSERT INTO inventory (
            inventory_id,
            drug_id,
            warehouse_id,
            batch_no,
            quantity,
            validity_date
        ) VALUES (
            #{inventory_id},
            #{drug_id},
            #{warehouse_id},
            #{batch_no},
            #{quantity},
            #{validity_date}
        )
    </insert>

    <!-- 修改库存记录 -->
    <update id="updateInventory" parameterType="com.example.spring_boot.entity.Inventory">
        UPDATE inventory
        SET
            drug_id = #{drug_id},
            warehouse_id = #{warehouse_id},
            batch_no = #{batch_no},
            quantity = #{quantity},
            validity_date = #{validity_date}
        WHERE inventory_id = #{inventory_id}
    </update>

    <!-- 删除库存记录 -->
    <delete id="deleteInventory">
        DELETE FROM inventory
        WHERE inventory_id = #{inventory_id}
    </delete>

    <!-- 根据ID查询库存记录 -->
    <select id="selectInventoryById" resultMap="InventoryResultMap">
        select * from inventory
        where inventory_id = #{inventory_id}
    </select>

    <!-- 查询所有库存记录 -->
    <select id="selectAllInventories" resultMap="InventoryResultMap">
        select * from inventory
        order by inventory_id
    </select>

    <!-- 根据药品ID查询库存记录 -->
    <select id="selectInventoriesByDrugId" resultMap="InventoryResultMap">
        select * from inventory
        where drug_id = #{drug_id}
    </select>

    <!-- 根据仓库ID查询库存记录 -->
    <select id="selectInventoriesByWarehouseId" resultMap="InventoryResultMap">
        select * from inventory
        where warehouse_id = #{warehouse_id}
    </select>

    <!-- 根据批号查询库存记录 -->
    <select id="selectInventoriesByBatchNo" resultMap="InventoryResultMap">
        select * from inventory
        where batch_no = #{batch_no}
    </select>

    <!-- 查询即将过期的库存 -->
    <select id="selectInventoriesNearExpiry" resultMap="InventoryResultMap">
        select * from inventory
        where validity_date &lt;= #{daysBeforeExpiry}
    </select>

    <!-- 查询库存不足的药品 -->
    <select id="selectLowStockInventories" resultMap="InventoryResultMap">
        select * from inventory
        where quantity &lt;= #{threshold}
    </select>

</mapper>