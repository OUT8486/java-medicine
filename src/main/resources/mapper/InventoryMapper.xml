<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spring_boot.dao.InventoryMapper">

    <!-- 库存结果映射 -->
    <resultMap id="InventoryResultMap" type="com.example.spring_boot.entity.Inventory">
        <id property="inventory_id" column="inventory_id"/>
        <result property="drug_id" column="drug_id"/>
        <result property="warehouse_id" column="warehouse_id"/>
        <result property="quantity" column="quantity"/>
        <result property="batch_number" column="batch_number"/>
        <result property="production_date" column="production_date"/>
        <result property="expiry_date" column="expiry_date"/>
        <result property="purchase_price" column="purchase_price"/>
        <result property="sale_price" column="sale_price"/>
    </resultMap>

    <!-- 新增库存记录 -->
    <insert id="insertInventory" parameterType="com.example.spring_boot.entity.Inventory">
        INSERT INTO inventory (
            inventory_id,
            drug_id,
            warehouse_id,
            quantity,
            batch_number,
            production_date,
            expiry_date,
            purchase_price,
            sale_price
        ) VALUES (
            #{inventory_id},
            #{drug_id},
            #{warehouse_id},
            #{quantity},
            #{batch_number},
            #{production_date},
            #{expiry_date},
            #{purchase_price},
            #{sale_price}
        )
    </insert>

    <!-- 修改库存记录 -->
    <update id="updateInventory" parameterType="com.example.spring_boot.entity.Inventory">
        UPDATE inventory
        SET
            drug_id = #{drug_id},
            warehouse_id = #{warehouse_id},
            quantity = #{quantity},
            batch_number = #{batch_number},
            production_date = #{production_date},
            expiry_date = #{expiry_date},
            purchase_price = #{purchase_price},
            sale_price = #{sale_price}
        WHERE inventory_id = #{inventory_id}
    </update>

    <!-- 删除库存记录 -->
    <delete id="deleteInventory">
        DELETE FROM inventory
        WHERE inventory_id = #{inventory_id}
    </delete>

    <!-- 根据ID查询库存记录 -->
    <select id="selectInventoryById" resultMap="InventoryResultMap">
        select * from inventory
        where inventory_id = #{inventory_id}
    </select>

    <!-- 查询所有库存记录 -->
    <select id="selectAllInventories" resultMap="InventoryResultMap">
        select * from inventory
        order by inventory_id
    </select>

</mapper>